@{
}

@model List<dashbordSales.Models.SalesBySalespersonModel>
@using Newtonsoft.Json

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    ViewData["Title"] = "Ventes par Vendeur";
}

<h2>Ventes par Vendeur</h2>

<div style="max-width: 700px; margin: auto;">
    <canvas id="salesBySalespersonChart"></canvas>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const ctx = document.getElementById('salesBySalespersonChart').getContext('2d');

    const chart = new Chart(ctx, {
        type: 'radar',
        data: {
            labels: @Html.Raw(JsonConvert.SerializeObject(Model.Select(x => x.SalespersonName))),
            datasets: [{
                label: 'Chiffre d\'Affaires',
                data: @Html.Raw(JsonConvert.SerializeObject(Model.Select(x => x.TotalSalesRevenue))),
                backgroundColor: 'rgba(54, 162, 235, 0.2)',
                borderColor: 'rgba(54, 162, 235, 1)',
                borderWidth: 2,
                pointBackgroundColor: 'rgba(54, 162, 235, 1)'
            }]
        },
        options: {
            responsive: true,
            scales: {
                r: {
                    ticks: {
                        callback: function(value) {
                            return value.toLocaleString() + ' €';
                        }
                    }
                }
            }
        }
    });
</script>
